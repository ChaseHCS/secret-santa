{
  "name": "secret-santa",
  "version": "1.0.0",
  "private": true,
  "description": "A free, private, serverless Secret Santa app for GitHub Pages.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "check": "node scripts/build-sw.mjs --check",
    "build:sw": "node scripts/build-sw.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
